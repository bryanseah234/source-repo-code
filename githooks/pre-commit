#!/usr/bin/env pwsh
$ErrorActionPreference = "Stop"

$repoRoot = git rev-parse --show-toplevel
if (-not $repoRoot) {
  exit 0
}

$candidates = @(
  (Join-Path $repoRoot "tools/scan_identity.py"),
  (Join-Path $PSScriptRoot "..\tools\scan_identity.py"),
  (Join-Path $env:USERPROFILE ".githooks\scan_identity.py")
)

$scanner = $null
foreach ($candidate in $candidates) {
  if ($candidate -and (Test-Path -LiteralPath $candidate)) {
    $scanner = $candidate
    break
  }
}

if (-not $scanner) {
  Write-Error "SHELL pre-commit: tools/scan_identity.py not found"
  exit 2
}

python $scanner $repoRoot --quiet
if ($LASTEXITCODE -ne 0) {
  Write-Error "SHELL pre-commit: identity scan failed"
  exit $LASTEXITCODE
}
